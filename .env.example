# 복사해서 .env 로 사용하세요 (.env 는 Git에 포함되지 않습니다)
# Windows: copy .env.example .env

# 필수: 세션 서명키 (32자 이상 난수). 생성 예:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# 실행 환경: dev | prod
APP_ENV=dev

# DB (기본: SQLite). PostgreSQL 예: postgresql+psycopg://user:pass@host:5432/vulportal
DATABASE_URL=sqlite:///./data/portal.db

# 데이터 디렉터리 (Web root 밖). 업로드/Bundle/로그 저장
DATA_DIR=./data

# 수집 모드: online (PoC, 인터넷 사용) | offline (VDI, Bundle Import만)
COLLECTOR_MODE=online

# 선택: NVD API Key (없으면 5 req/30s 제한)
NVD_API_KEY=

# 업로드 최대 크기(byte)
UPLOAD_MAX_BYTES=5242880

# 세션 유휴 만료(분)
SESSION_IDLE_MINUTES=30

# 정책 파일
POLICY_FILE=./config/policy.yaml
